APP_NAME=Ballotify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8883

# Public URL of the Nuxt frontend (voting links + CORS)
FRONTEND_URL=http://localhost:3000
# Production: what sits in front of the app, so per-IP limits see each visitor's real IP.
# 127.0.0.1 = Nginx on the same server; * = behind Cloudflare or a load balancer. Empty locally.
TRUSTED_PROXIES=
# Optional: extra allowed CORS origins, comma separated (defaults to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ballotify
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live results: "reverb" (Laravel Reverb, run `php artisan reverb:start`), or "log" to disable.
# Without a running Reverb server the results page simply refreshes every 15 seconds.
# Live results: pusher (hosted, works on shared hosting) | reverb (self-hosted, needs a
# long-running process) | null (off: results pages refresh every 15 s).
BROADCAST_CONNECTION=reverb

# Pusher (BROADCAST_CONNECTION=pusher): dashboard.pusher.com -> your app -> App Keys.
# The frontend needs the same key and cluster (NUXT_PUBLIC_PUSHER_KEY / _CLUSTER).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
FILESYSTEM_DISK=local
# sync = no worker needed (messages go out right after the request).
# database/redis = send in a background worker (`composer dev` / `php artisan queue:work`), best for very large lists.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (live results). Generate your own random values for KEY/SECRET.
REVERB_APP_ID=ballotify
REVERB_APP_KEY=change-me-key
REVERB_APP_SECRET=change-me-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# ---------------------------------------------------------------------------
# Voter invitations
#   With QUEUE_CONNECTION=sync (default) messages are sent right after the
#   request returns: no worker needed. For very large lists you can switch to
#   a background worker instead (see QUEUE_CONNECTION above).
#
# EMAIL: set MAIL_MAILER (smtp, mailgun, postmark, ses, resend…) and its
#   credentials above. MAIL_MAILER=log keeps email in test mode (written to
#   storage/logs/laravel.log). Set MAIL_FROM_ADDRESS to an address on your domain.
#
# SMS: SMS_DRIVER = log (test mode) | termii | africastalking | twilio
#   A driver whose credentials are missing stays in test mode.
# ---------------------------------------------------------------------------
SMS_DRIVER=log
# Converts local numbers like 0801 234 5678 to +2348012345678 (234 = Nigeria)
SMS_DEFAULT_COUNTRY_CODE=234

# Termii (https://termii.com) - sender ID must be approved by Termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# generic, or dnd to reach numbers on Do-Not-Disturb (Nigeria)
TERMII_CHANNEL=generic

# Africa's Talking (https://africastalking.com) - username "sandbox" for testing
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# Twilio (https://twilio.com)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------------------
# Security & privacy
# ---------------------------------------------------------------------------
# Minutes an organiser login stays valid (10080 = 7 days)
SANCTUM_EXPIRATION=10080
# Days after an event closes before voter emails/phones are erased automatically (0 = never).
# Needs the scheduler: `php artisan schedule:work` (dev) or a cron running `php artisan schedule:run`.
VOTER_CONTACT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Billing: pay per event with Paystack (https://dashboard.paystack.com)
# Free events have limits until upgraded to Pro. Prices and limits are edited
# by the platform admin on the Admin page. BILLING_ENABLED=false removes all
# limits and payments (every event behaves as Pro).
# Webhook URL to set in Paystack: {APP_URL}/api/paystack/webhook
# ---------------------------------------------------------------------------
BILLING_ENABLED=true
PAYSTACK_SECRET_KEY=

# Backup payment provider: Flutterwave (https://app.flutterwave.com -> Settings -> API keys).
# Used automatically when Paystack can't start a payment. Empty = no backup.
# Webhook URL to set in Flutterwave: {APP_URL}/api/flutterwave/webhook, with a secret hash
# (any long random string) that you also put in FLUTTERWAVE_WEBHOOK_HASH.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Order of preference (the next one is used when one is down).
PAYMENT_PROVIDERS=paystack,flutterwave

# Bot / card-testing protection: Cloudflare Turnstile (free). Empty = off.
# Create a widget at https://dash.cloudflare.com -> Turnstile; put the SITE key in the frontend .env.
TURNSTILE_SECRET_KEY=

# USSD voting via Africa's Talking (uses the AFRICASTALKING_* keys above).
# In Africa's Talking, set the USSD callback URL to {APP_URL}/api/ussd/{USSD_WEBHOOK_SECRET}
USSD_SERVICE_CODE=
USSD_WEBHOOK_SECRET=
