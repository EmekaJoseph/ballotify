APP_NAME=Ballotify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8883

# Public URL of the Nuxt frontend (voting links + CORS)
FRONTEND_URL=http://localhost:3000
# Optional: extra allowed CORS origins, comma separated (defaults to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ballotify
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use "pusher" for live results (set the PUSHER_* keys below); "log" disables it
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = no worker needed (messages go out right after the request).
# database/redis = send in a background worker (`composer dev` / `php artisan queue:work`), best for very large lists.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=your-app-id
PUSHER_APP_KEY=your-key
PUSHER_APP_SECRET=your-secret
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
# ---------------------------------------------------------------------------
# Voter invitations
#   With QUEUE_CONNECTION=sync (default) messages are sent right after the
#   request returns: no worker needed. For very large lists you can switch to
#   a background worker instead (see QUEUE_CONNECTION above).
#
# EMAIL: set MAIL_MAILER (smtp, mailgun, postmark, ses, resend…) and its
#   credentials above. MAIL_MAILER=log keeps email in test mode (written to
#   storage/logs/laravel.log). Set MAIL_FROM_ADDRESS to an address on your domain.
#
# SMS: SMS_DRIVER = log (test mode) | termii | africastalking | twilio
#   A driver whose credentials are missing stays in test mode.
# ---------------------------------------------------------------------------
SMS_DRIVER=log
# Converts local numbers like 0801 234 5678 to +2348012345678 (234 = Nigeria)
SMS_DEFAULT_COUNTRY_CODE=234

# Termii (https://termii.com) - sender ID must be approved by Termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# generic, or dnd to reach numbers on Do-Not-Disturb (Nigeria)
TERMII_CHANNEL=generic

# Africa's Talking (https://africastalking.com) - username "sandbox" for testing
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# Twilio (https://twilio.com)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
