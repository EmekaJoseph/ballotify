# Base URL of the Ballotify Laravel API (include /api)
NUXT_PUBLIC_API_BASE=http://localhost:8883/api

# Live results, option 1: Pusher (hosted; nothing to run on the server). Key and cluster from
# dashboard.pusher.com -> your app -> App Keys. The backend needs BROADCAST_CONNECTION=pusher.
# Set here, it takes priority over Reverb below.
NUXT_PUBLIC_PUSHER_KEY=
NUXT_PUBLIC_PUSHER_CLUSTER=

# Live results, option 2 (Laravel Reverb, self-hosted). Must match REVERB_APP_KEY / REVERB_HOST / REVERB_PORT in backend/.env.
# Leave the key empty to fall back to refreshing results every 15 seconds.
NUXT_PUBLIC_REVERB_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# Shown on the Privacy and Terms pages
NUXT_PUBLIC_COMPANY_NAME=Ballotify
NUXT_PUBLIC_CONTACT_EMAIL=
# Organiser support: WhatsApp number (international, e.g. 2348012345678) for the "Help" chat button,
# and a YouTube/Vimeo link to a short tour for the Help centre. Empty = hidden.
NUXT_PUBLIC_SUPPORT_WHATSAPP=
NUXT_PUBLIC_HELP_VIDEO_URL=

# Cloudflare Turnstile site key (bot protection). Empty = off.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
