# Base URL of the Ballotify Laravel API (include /api)
NUXT_PUBLIC_API_BASE=http://localhost:8883/api

# Live results (Laravel Reverb). Must match REVERB_APP_KEY / REVERB_HOST / REVERB_PORT in backend/.env.
# Leave the key empty to fall back to refreshing results every 15 seconds.
NUXT_PUBLIC_REVERB_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# Shown on the Privacy and Terms pages
NUXT_PUBLIC_COMPANY_NAME=Ballotify
NUXT_PUBLIC_CONTACT_EMAIL=
